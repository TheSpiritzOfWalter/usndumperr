# Run this script in PowerShell as Administrator
$DriveLetter = "C"
$OutputFile = "${DriveLetter}:\USN_Journal_Export.csv"

Write-Host "Querying USN Journal for drive ${DriveLetter}:..." -ForegroundColor Cyan

# Exporting USN records in CSV format directly to the root of the target drive
fsutil usn readJournal ${DriveLetter}: csv > "$OutputFile"

Write-Host "USN Journal data successfully exported to $OutputFile" -ForegroundColor Green
