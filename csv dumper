# Run this script in PowerShell as Administrator
$DriveLetter = "C"
$OutputFile = "${DriveLetter}:\Filtered_USN_Journal.csv"

Write-Host "Querying and filtering USN Journal for .exe, .dll, and .lua files..." -ForegroundColor Cyan

# Query the USN journal, skip header lines, filter by extension, and output to CSV
fsutil usn readJournal ${DriveLetter}: csv | Where-Object { 
    $_ -match '\.(exe|dll|lua)"' 
} | Out-File -FilePath "$OutputFile" -Encoding utf8

Write-Host "Filtered USN Journal successfully saved to $OutputFile" -ForegroundColor Green
